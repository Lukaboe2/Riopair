{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/code", "destination": "/api/index" },
    { "source": "/qr/session", "destination": "/api/index" },
    { "source": "/session/:id", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ]
}
