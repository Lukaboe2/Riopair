{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/public/index.html" },
    { "src": "^/pair/?$", "dest": "/public/pair.html" },
    { "src": "^/qr/?$", "dest": "/public/qr.html" },
    { "src": "^/(.*)$", "dest": "/public/$1" }
  ]
}
